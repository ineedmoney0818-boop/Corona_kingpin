    "\\bclips? (are|were|was) (bad|random|boring|terrible|useless)",
    "\\bout of context\\b",
    "\\bmid.?sentence\\b",
    "\\bcut(s)? (me |them )?off\\b",
    "\\birrelevant\\b",
    "\\bviral(ity)? score\\b",
    "\\bpicks? (the )?wrong\\b",
    "\\bmakes no sense\\b",
    "\\bai (is|was) (bad|terrible|dumb|useless)\\b"
   ]
  },
  {
   "id": "captions",
