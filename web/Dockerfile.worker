# Render worker for Railway (or any container host). Build context: web/
# Claims queued renders from Supabase, renders with Remotion + headless Chrome, uploads, refunds on failure.
ARG BASE_IMAGE=node:24-bookworm-slim
FROM ${BASE_IMAGE}

# Shared libraries headless Chrome needs (Remotion's documented Debian list) + fonts and CA certs.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates fonts-noto-color-emoji fonts-liberation \
      libnss3 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libgbm1 libasound2 libxrandr2 \
      libxkbcommon0 libxfixes3 libxcomposite1 libxdamage1 libpango-1.0-0 libcairo2 libcups2 libdrm2 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
# Download Remotion's pinned Chrome Headless Shell at build time, not on the first job.
RUN npx remotion browser ensure

COPY . .

ENV NODE_ENV=production RENDER_IN_PROCESS=0 RENDER_SCALE=1 REELPLAIN_ROOT=/app
# Run tsx directly (not via npm) so SIGTERM reaches the worker and it finishes the current render before exiting.
CMD ["node_modules/.bin/tsx", "--tsconfig", "tsconfig.json", "src/worker/main.ts"]
