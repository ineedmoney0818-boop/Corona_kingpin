# Reelplain environment. Copy to .env.local for development. Never commit real values.
# With no Supabase URL the app runs on the local fake store (dev only).

# --- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project settings > API). Publishable key is safe in the browser; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# --- Claude planner (console.anthropic.com). Server only.
ANTHROPIC_API_KEY=
# Optional override; leave empty to use https://api.anthropic.com
REELPLAIN_ANTHROPIC_BASE_URL=

# --- Stripe (test mode until launch). Server only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend, from your own verified domain)
RESEND_API_KEY=
EMAIL_FROM=Reelplain <hello@your-domain.com>

# --- Jobs
# Shared secret the host's cron sends as "Authorization: Bearer ..."
CRON_SECRET=
# 0 on the web app in production: the separate worker renders. 1 (default) renders in-process for local dev.
RENDER_IN_PROCESS=1
# 1 in production (1080x1920). Defaults to 0.5 in development for speed.
RENDER_SCALE=
# Path to a Chrome/headless-shell binary for Remotion, if not the default
REMOTION_BROWSER=
